# Publishable/anonymous key is used with the authenticated user's JWT; RLS
# restricts device enrollment and lookup to that user. Never use a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=
NVIDIA_TTS_MAGPIE_URL=
NVIDIA_TTS_MAGPIE_DEFAULT_VOICE=
NVIDIA_TTS_CHATTERBOX_URL=
NVIDIA_TTS_CHATTERBOX_DEFAULT_VOICE=
PIPER_FARSI_URL=
PIPER_SERVICE_TOKEN=
PIPER_FARSI_DEFAULT_VOICE=mana

# Access control (2026-09-30 pre-launch audit). Default is invite-only: ONLY
# the emails listed here can use Cloud Voice. Set VOICE_ACCESS_MODE=open to let
# any signed-in Supabase account through. Also disable "Allow new users to sign
# up" in the Supabase Auth settings -- the iOS app no longer auto-creates
# accounts, but the public anon key could still be used to sign up directly.
VOICE_ACCESS_MODE=invite
VOICE_ALLOWED_EMAILS=
# Per-user limits on the NVIDIA-billed endpoints (0 disables a limit).
VOICE_RATE_PER_MINUTE=20
VOICE_DAILY_QUOTA=300
