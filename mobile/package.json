{
  "name": "alphonso-phone",
  "private": true,
  "version": "0.1.0",
  "description": "Alphonso on the phone: the Capacitor app around the desktop's phone screens (src/mobile).",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "sync": "cap sync",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "firebase-config": "node scripts/firebase-config.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "8.0.1",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
